load("@gpui_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load(":macos_bundle.bzl", "macos_bundle")
load(":mailrender.bzl", "mailrender")
load(":package_binary.bzl", "package_binary")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
])

package_binary(
    name = "durian-cli",
    src = "//cli/cmd/durian",
)

genrule(
    name = "app_version",
    outs = ["app-version.env"],
    cmd = """
        awk '
            $$1 == "STABLE_VERSION" { print "DURIAN_VERSION=" $$2 }
            $$1 == "STABLE_BUILD_NUMBER" { print "DURIAN_BUILD_NUMBER=" $$2 }
            $$1 == "STABLE_GIT_COMMIT" { revision = $$2 }
            $$1 == "STABLE_GIT_DIRTY" && $$2 == "true" { dirty = "-dirty" }
            END { print "DURIAN_REVISION=" revision dirty }
        ' bazel-out/stable-status.txt > $@
    """,
    stamp = True,
)

macos_bundle(
    name = "DurianPreview",
    cli = ":durian-cli",
    gui = ":durian",
    icon = "//macos:durian/CompiledIcons/release/AppIcon.icns",
    license = "//:LICENSE",
    plist = "Info.plist",
    renderer = ":mailrender",
    target_compatible_with = ["@platforms//os:macos"],
    version = ":app_version",
)

sh_test(
    name = "package_macos_test",
    size = "small",
    srcs = ["package_macos_test.sh"],
    args = [
        "$(location package_macos.sh)",
        "$(location Info.plist)",
        "$(location //macos:durian/CompiledIcons/release/AppIcon.icns)",
        "$(location //:LICENSE)",
    ],
    data = [
        "Info.plist",
        "package_macos.sh",
        "//:LICENSE",
        "//macos:durian/CompiledIcons/release/AppIcon.icns",
    ],
)

mailrender(
    name = "mailrender",
    linux = select({
        "@platforms//os:linux": True,
        "//conditions:default": False,
    }),
    out_dir = "//app/crates/mail:mailrender_output",
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

rust_binary(
    name = "durian",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob([
        "assets/**",
        "data/**",
    ]),
    crate_name = "durian_gpui",
    crate_root = "src/main.rs",
    # html_render finds a packaged helper beside current_exe. Do not depend on
    # build.rs's compile-sandbox absolute path surviving at runtime.
    data = [":durian-cli"] + select({
        "@platforms//os:macos": [":mailrender"],
        "@platforms//os:linux": [":mailrender"],
        "//conditions:default": [],
    }),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = [":app_version"],
    visibility = ["//visibility:public"],
    deps = [
        "//app/crates/calendar",
        "//app/crates/mail",
        "//app/crates/ui",
    ] + all_crate_deps(normal = True),
)

rust_test(
    name = "durian_test",
    size = "small",
    crate = ":durian",
)
