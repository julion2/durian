load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "demo_session_lib",
    testonly = True,
    srcs = ["calendars.go", "main.go"],
    importpath = "github.com/julion2/durian/cli/cmd/demo-session",
    visibility = ["//visibility:private"],
    deps = [
        "//cli/internal/backend",
        "//cli/internal/calendar",
        "//cli/internal/calendarsync",
        "//cli/internal/calendartest",
        "//cli/internal/config",
        "//cli/internal/contacts",
        "//cli/internal/dbcrypto",
        "//cli/internal/demotest",
        "//cli/internal/googlecalendar",
        "//cli/internal/graphcalendar",
        "//cli/internal/handler",
        "//cli/internal/store",
        "//cli/internal/syncengine",
    ],
)

go_binary(
    name = "demo-session",
    testonly = True,
    embed = [":demo_session_lib"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    x_defs = {
        "main.version": "{STABLE_VERSION}",
        "main.gitCommit": "{STABLE_GIT_COMMIT}",
    },
)

go_test(
    name = "demo_session_test",
    size = "small",
    srcs = ["calendars_test.go", "main_test.go"],
    embed = [":demo_session_lib"],
    deps = [
        "//cli/internal/calendar",
        "//cli/internal/calendarsync",
        "//cli/internal/config",
        "//cli/internal/demotest",
        "//cli/internal/handler",
    ],
)
