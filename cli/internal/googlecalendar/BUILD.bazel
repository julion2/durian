load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "googlecalendar",
    srcs = [
        "delta.go",
        "googlecalendar.go",
        "timezone.go",
        "write.go",
    ],
    importpath = "github.com/julion2/durian/cli/internal/googlecalendar",
    visibility = ["//cli:__subpackages__"],
    deps = [
        "//cli/internal/calendar",
        "//cli/internal/calendarsync",
        "//cli/internal/config",
        "//cli/internal/oauth",
        "//cli/internal/redact",
        "@com_github_teambition_rrule_go//:rrule-go",
    ],
)

go_test(
    name = "googlecalendar_test",
    size = "small",
    srcs = [
        "delta_test.go",
        "googlecalendar_test.go",
        "provider_contract_test.go",
        "series_exceptions_test.go",
        "throttle_test.go",
        "timezone_test.go",
        "write_test.go",
    ],
    data = ["testdata/google-timezones.json"],
    embed = [":googlecalendar"],
    deps = [
        "//cli/internal/calendar",
        "//cli/internal/calendarsync",
        "//cli/internal/calendartest",
    ],
)

go_test(
    name = "googlecalendar_live_integration_test",
    size = "large",
    srcs = ["live_integration_test.go", "provider_contract_test.go"],
    embed = [":googlecalendar"],
    gotags = ["calendarintegration"],
    tags = ["manual"],
    deps = [
        "//cli/internal/calendar",
        "//cli/internal/calendarsync",
        "//cli/internal/calendartest",
    ],
)
