load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "imapbackend",
    srcs = ["imapbackend.go"],
    importpath = "github.com/julion2/durian/cli/internal/imapbackend",
    visibility = ["//cli:__subpackages__"],
    deps = [
        "//cli/internal/backend",
        "//cli/internal/config",
        "//cli/internal/imap",
        "//cli/internal/mail",
        "//cli/internal/redact",
        "@com_github_emersion_go_imap//:go-imap",
    ],
)

go_test(
    name = "imapbackend_test",
    size = "small",
    srcs = [
        "imapbackend_test.go",
        "protocol_adversarial_test.go",
    ],
    embed = [":imapbackend"],
    deps = [
        "//cli/internal/backend",
        "//cli/internal/config",
        "//cli/internal/imap",
        "//cli/internal/redact",
        "@com_github_emersion_go_imap//:go-imap",
        "@com_github_emersion_go_imap//backend",
        "@com_github_emersion_go_imap//client",
        "@com_github_emersion_go_imap//server",
    ],
)
