# macOS system files
.DS_Store

# Xcode (macos/Durian.xcodeproj is tracked, but user-local state is not)
xcuserdata/
DerivedData/
build/
*.hmap
*.dSYM
*.dSYM.zip
*.ipa

# Swift Package Manager (via Xcode's integrated SPM)
.build/

# IDEs / editors
.idea/
.claude/
.bazelbsp/

# Go binaries (local builds outside Bazel)
cli/durian
bin/

# Pkl schemas staged into the config package for tooling that type-checks
# outside Bazel (golangci-lint). Bazel's copy_schemas genrule produces the
# same files into its sandbox; //schema holds the tracked originals.
cli/internal/config/schema/

# Bazel (symlinks only — MODULE.bazel.lock is tracked for reproducibility)
/bazel-*
.bazelrc.user

# Vagrant
.vagrant/
