bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "apple_support", version = "2.2.0")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "rules_swift", version = "3.6.1")
bazel_dep(name = "rules_apple", version = "4.5.3")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")

# Pin Go to a patched stdlib. 1.26.9 fixes the October 2026 vulnerabilities
# in net/http, net/textproto and crypto/tls (including GO-2026-6617).
# Go 1.25 has no patched release for these. Without an explicit version, rules_go
# falls back to its bundled default which lags behind. Keep in lockstep with the
# `go` directive in cli/go.mod (govulncheck installs that version in CI).
go_sdk.download(version = "1.26.9")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//cli:go.mod")
use_repo(go_deps, "com_github_apple_pkl_go", "com_github_emersion_go_ical", "com_github_emersion_go_imap", "com_github_emersion_go_sasl", "com_github_fatih_color", "com_github_google_uuid", "com_github_gorilla_mux", "com_github_microcosm_cc_bluemonday", "com_github_rivo_uniseg", "com_github_spf13_cobra", "com_github_teambition_rrule_go", "io_filippo_age", "org_golang_x_net", "org_golang_x_term", "org_golang_x_text", "org_modernc_sqlite")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

qt_local_repository = use_repo_rule("//linux:qt_repo.bzl", "qt_local_repository")

qt_local_repository(
    name = "qt",
)
