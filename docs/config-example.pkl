// Durian Configuration
// Copy to ~/.config/durian/config.pkl
// Remove the example accounts below and add your own.
import "modulepath:/Config.pkl" as C

settings: C.SettingsConfig = new {
  theme = "system"                    // "light", "dark", or "system"
  notifications_enabled = true        // Global notification toggle
  load_remote_images = false          // Block tracking pixels by default
  // accent_color = "#3B82F6"         // Optional: app-wide accent color (hex)
}

// Optional: override the contacts database location.
// Default: ~/.local/share/durian/contacts.db (XDG_DATA_HOME)
// contacts: C.ContactsConfig = new { db_path = "~/.local/share/durian/contacts.db" }

// Optional: calendar settings. `durian serve` runs a background calendar sync
// (autosync): remote changes are pulled into the local vdir. By default
// (autosync_upload = "none") it is DOWNLOAD-ONLY: nothing is ever uploaded,
// deleted remotely or RSVP'd automatically — those need an interactive
// `durian calendar sync` with its confirmation prompt. With
// autosync_upload = "safe", autosync additionally auto-applies provably
// non-notifying local changes (creates/edits of events WITHOUT attendees);
// remote deletes, conflicts, RSVPs and anything that could make the provider
// send email still wait for the interactive sync.
// Override per account with accounts[*].calendar { autosync = false } or
// accounts[*].calendar { autosync_upload = "safe" }.
// calendar: C.CalendarConfig = new {
//   vdir_path = "~/.local/share/durian/calendars"
//   autosync = true            // Background sync in `durian serve`
//   autosync_interval = 600    // Seconds between autosync runs (minimum 60, default 600)
//   autosync_upload = "none"   // "none" = download-only; "safe" = also push
//                              // non-notifying local changes (never deletes)
//   conflict = "newer"         // Both-sides edit: "newer" (default) keeps the
//                              // last-modified side, "remote", or "local"
//                              // (the losing local file is always backed up)
//
//   // Calendars that live only on disk: each entry is one folder of .ics
//   // files. They belong to no account and no provider, so the sync engine
//   // never touches them — nothing is uploaded, nothing is pruned, and no
//   // invitation can be sent for an event in them. Point an entry at an
//   // existing khal or vdirsyncer collection to show it as-is. Addressed as
//   // the reserved account "local": `durian calendar list local`.
//   // Note the explicit `new C.LocalCalendar`: a bare `new { ... }` inside a
//   // typed Listing evaluates to Dynamic and Pkl rejects it.
//   local_calendars = new Listing {
//     new C.LocalCalendar {
//       name = "Privat"                // Display name, and the --calendar value
//       path = "~/Kalender/privat"     // Created on first write if missing
//       color = "#8ab4f8"              // Optional; else the collection's own
//                                      // `color` meta file
//     }
//     new C.LocalCalendar {
//       name = "Verein"
//       path = "~/Nextcloud/verein-cal"
//       read_only = true               // Never written by durian
//     }
//   }
// }

sync: C.SyncConfig = new {
  gui_auto_sync = true                // GUI auto-syncs on launch and periodically
  auto_fetch_interval = 120           // Quick sync interval in seconds (GUI)
  full_sync_interval = 7200           // Full sync interval in seconds (GUI)

  // Optional: sync tags across machines via a self-hosted sync server.
  // tag_sync { url = "http://nas:8724"; api_key = "your-secret" }

  // Optional: attachment cache settings (GUI prefetches on thread open).
  // attachment_cache { max_size_mb = 100; ttl_days = 7 }

  // Optional: extra MIME headers to fetch and index (for rules.pkl matching
  // against provider-specific headers). After changing the list, run
  // `durian sync --backfill-headers` once to populate existing messages.
  // indexed_headers { "X-GitLab-NotificationReason"; "X-Spam-Status" }
}

signatures: Mapping<String, String> = new {
  ["default"] = "Best regards"
  ["work"] = """
    <b>Your Name</b><br>
    Position<br>
    <b>Company Inc.</b><br>
    <br>
    Phone: +1 234 567 890<br>
    Email: <a href="mailto:you@company.com">you@company.com</a><br>
    Web: <a href="https://company.com">company.com</a>
    """
}

accounts: Listing<C.AccountConfig> = new {
  // ── Password auth (e.g. GMX, Hostinger, LRZ) ──────────────
  new {
    name = "Personal"
    email = "you@example.com"
    display_name = "Your Name"         // Used in From header
    alias = "personal"                 // Short alias for CLI: durian sync personal
    default_signature = "default"      // Signature key from signatures {}
    smtp {
      host = "smtp.example.com"; port = 587; auth = "password"
      // max_attachment_size = "10MB"   // Optional: outgoing attachment cap (default "25MB")
    }
    imap {
      host = "imap.example.com"; port = 993; auth = "password"; max_messages = 5000
      // batch_size = 100               // Optional: messages fetched per IMAP round trip (default 100)
    }
    auth { username = "you@example.com" }
    // Then run: durian auth login personal
  }

  // ── Microsoft 365 OAuth ──────────────────────────────────
  (C.microsoft365) {
    name = "Work"
    email = "you@company.com"
    display_name = "Your Name"
    alias = "work"
    default = true                     // Default account for compose
    default_signature = "work"
    notifications = true               // Per-account notification override

    // Optional: single-tenant Azure app registration (default "common").
    // oauth { tenant = "your-tenant-id" }

    // Microsoft accounts sync over Microsoft Graph. The C.microsoft365 preset
    // already sets sync_engine = "graph" for you, and "legacy"/"engine" (IMAP)
    // are rejected for Microsoft — so you never set this by hand here.

    // Optional: per-account calendar sync settings (Microsoft and Google
    // OAuth accounts). All keys are optional; the block itself is too —
    // `durian calendar sync <alias>` works without it.
    // calendar {
    //   enabled = false                // Disable calendar reads and sync for this account (default: true)
    //   dir = "work"                   // Subdir under calendar.vdir_path (default: account alias)
    //   include { "Calendar"; "Team" } // Calendar names to export and sync (default: all)
    //   conflict = "remote"            // "remote" (default; local file backed up first), "local", or "newer"
    //   autosync = false               // Override the global calendar.autosync toggle
    //   autosync_upload = "safe"       // Override the global calendar.autosync_upload mode
    // }

    // Then run: durian auth login work
  }

  // ── Microsoft 365 Shared Mailbox ─────────────────────────
  // See https://julion2.github.io/durian/docs/auth/oauth/ for shared mailbox OAuth setup.
  (C.microsoft365Shared) {
    name = "Support"
    email = "support@company.com"
    auth_email = "you@company.com"     // Delegating user (must have Full Access + Send As)
    display_name = "Company Support"
    default_signature = "work"
    alias = "support"
  }

  // ── Google OAuth ─────────────────────────────────────────
  (C.gmail) {
    name = "Gmail"
    email = "you@gmail.com"
    alias = "gmail"
    oauth {
      client_id = "your-google-client-id"         // Required, see https://julion2.github.io/durian/docs/auth/oauth/
      client_secret = "your-google-client-secret"  // Required, see https://julion2.github.io/durian/docs/auth/oauth/
    }
    // Google accounts sync over the Gmail REST API by default (labels become
    // tags); the C.gmail preset sets sync_engine = "gmail". Enable the Gmail API
    // once in your Cloud project. To fall back to IMAP: sync_engine = "legacy".
    // Then run: durian auth login gmail
  }

  // ── JMAP (Fastmail or compatible server) ─────────────────
  new {
    name = "Fastmail"
    email = "you@example.com"
    alias = "fastmail"
    jmap {
      session_url = "https://api.fastmail.com/jmap/session"
      auth = "bearer"                  // "password" for Basic-auth JMAP servers
    }
    sync_engine = "jmap"
    // Then run: durian auth login fastmail and paste a Fastmail API token.
  }
}
