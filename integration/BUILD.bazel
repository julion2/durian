sh_test(
    name = "integration_test",
    size = "medium",
    srcs = ["integration_test.sh"],
    args = [
        "$(location //cli/cmd/testseeder)",
        "$(location //cli/cmd/durian)",
        "$(location testdata/config.pkl)",
    ],
    data = [
        "testdata/config.pkl",
        "testdata/profiles.pkl",
        "//cli/cmd/durian",
        "//cli/cmd/testseeder",
    ],
    tags = ["integration"],
)

# Real WebKit engine, local HTTPS traps, and native snapshot/text interaction.
sh_test(
    name = "mailrender_test",
    size = "medium",
    srcs = ["mailrender_test.sh"],
    args = ["$(location //gpui:durian)", "$(location //gpui/crates/mail:prepare_html)"],
    data = ["testdata/mailrender_contract.py", "//gpui:durian", "//gpui/crates/mail:prepare_html"],
    tags = ["integration", "local", "manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

